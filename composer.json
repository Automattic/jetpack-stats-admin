{
	"name": "automattic/jetpack-stats-admin",
	"description": "Stats Dashboard",
	"type": "jetpack-library",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.2",
		"automattic/jetpack-connection": "^6.7.0-alpha",
		"automattic/jetpack-constants": "^3.0.2",
		"automattic/jetpack-plans": "^0.5.3",
		"automattic/jetpack-stats": "^0.15.2",
		"automattic/jetpack-status": "^5.0.5-alpha",
		"automattic/jetpack-jitm": "^4.2.0-alpha"
	},
	"require-dev": {
		"yoast/phpunit-polyfills": "^1.1.1",
		"automattic/jetpack-changelogger": "^6.0.0",
		"automattic/jetpack-test-environment": "@dev"
	},
	"suggest": {
		"automattic/jetpack-autoloader": "Allow for better interoperability with other plugins that use this package."
	},
	"autoload": {
		"classmap": [
			"src/"
		]
	},
	"scripts": {
		"phpunit": [
			"./vendor/phpunit/phpunit/phpunit --colors=always"
		],
		"test-coverage": [
			"php -dpcov.directory=. ./vendor/bin/phpunit --coverage-php \"$COVERAGE_DIR/php.cov\""
		],
		"test-php": [
			"@composer phpunit"
		],
		"build-production": "echo 'Add your build step to composer.json, please!'",
		"build-development": "echo 'Add your build step to composer.json, please!'"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"extra": {
		"autotagger": true,
		"mirror-repo": "Automattic/jetpack-stats-admin",
		"branch-alias": {
			"dev-trunk": "0.24.x-dev"
		},
		"textdomain": "jetpack-stats-admin",
		"version-constants": {
			"::VERSION": "src/class-main.php"
		}
	},
	"config": {
		"allow-plugins": {
			"roots/wordpress-core-installer": true
		}
	}
}
