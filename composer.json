{
	"name": "automattic/jetpack-stats-admin",
	"description": "Stats Dashboard",
	"type": "jetpack-library",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4",
		"automattic/jetpack-admin-ui": "^0.14.3",
		"automattic/jetpack-connection": "^9.9.1",
		"automattic/jetpack-constants": "^4.0.0",
		"automattic/jetpack-plans": "^0.14.1",
		"automattic/jetpack-stats": "^0.22.1",
		"automattic/jetpack-status": "^7.1.0",
		"automattic/jetpack-jitm": "^5.1.2-alpha"
	},
	"require-dev": {
		"yoast/phpunit-polyfills": "^4.0.0",
		"automattic/jetpack-blaze": "^0.29.9-alpha",
		"automattic/phpunit-select-config": "^1.0.11"
	},
	"suggest": {
		"automattic/jetpack-autoloader": "Allow for better interoperability with other plugins that use this package."
	},
	"autoload": {
		"classmap": [
			"src/"
		]
	},
	"scripts": {
		"phpunit": [
			"phpunit-select-config phpunit.#.xml.dist --colors=always"
		],
		"test-php": "@composer phpunit",
		"test-php-coverage": "php -dpcov.directory=. ./vendor/bin/phpunit-select-config phpunit.#.xml.dist --coverage-php \"$COVERAGE_DIR/php.cov\"",
		"build-production": "echo 'Add your build step to composer.json, please!'",
		"build-development": "echo 'Add your build step to composer.json, please!'"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"extra": {
		"autotagger": true,
		"mirror-repo": "Automattic/jetpack-stats-admin",
		"branch-alias": {
			"dev-trunk": "0.39.x-dev"
		},
		"textdomain": "jetpack-stats-admin",
		"version-constants": {
			"::VERSION": "src/class-main.php"
		}
	},
	"config": {
		"allow-plugins": {
			"roots/wordpress-core-installer": true
		}
	}
}
