{
	"name": "automattic/jetpack-stats-admin",
	"description": "Stats Dashboard",
	"type": "jetpack-library",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.2",
		"automattic/jetpack-connection": "^8.3.7-alpha",
		"automattic/jetpack-blaze": "^0.27.19-alpha",
		"automattic/jetpack-constants": "^3.0.10",
		"automattic/jetpack-plans": "^0.11.6",
		"automattic/jetpack-stats": "^0.19.2-alpha",
		"automattic/jetpack-status": "^6.1.5-alpha",
		"automattic/jetpack-jitm": "^4.3.36-alpha"
	},
	"require-dev": {
		"yoast/phpunit-polyfills": "^4.0.0",
		"automattic/jetpack-test-environment": "@dev",
		"automattic/phpunit-select-config": "^1.0.6"
	},
	"suggest": {
		"automattic/jetpack-autoloader": "Allow for better interoperability with other plugins that use this package."
	},
	"autoload": {
		"classmap": [
			"src/"
		]
	},
	"scripts": {
		"phpunit": [
			"phpunit-select-config phpunit.#.xml.dist --colors=always"
		],
		"test-coverage": [
			"php -dpcov.directory=. ./vendor/bin/phpunit-select-config phpunit.#.xml.dist --coverage-php \"$COVERAGE_DIR/php.cov\""
		],
		"test-php": [
			"@composer phpunit"
		],
		"build-production": "echo 'Add your build step to composer.json, please!'",
		"build-development": "echo 'Add your build step to composer.json, please!'"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"extra": {
		"autotagger": true,
		"mirror-repo": "Automattic/jetpack-stats-admin",
		"branch-alias": {
			"dev-trunk": "0.31.x-dev"
		},
		"textdomain": "jetpack-stats-admin",
		"version-constants": {
			"::VERSION": "src/class-main.php"
		}
	},
	"config": {
		"allow-plugins": {
			"roots/wordpress-core-installer": true
		}
	}
}
